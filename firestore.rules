rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'qhn0gWsCoAoQkCjfTGEA' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection: managed by super admin
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == 'qhn0gWsCoAoQkCjfTGEA');
    }

    // Equipment collection: Public/Staff can view equipment catalog, admin and staff can manage
    match /equipment/{equipmentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Loans collection: Loan requests, delivery, and returns
    match /loans/{loanId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Audit logs for PDPA tracking and operational transparency
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
